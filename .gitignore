# ===========================================================================
# EduSimplify - .gitignore
# ===========================================================================

# --- Credentials & secrets (NEVER commit these) ---
.env
*.env

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyc

# --- Virtual environments ---
venv/
.venv/
env/
.env.local

# --- Distribution / packaging ---
dist/
build/
*.egg-info/

# --- OS artefacts ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/

# --- Test / coverage ---
.pytest_cache/
htmlcov/
.coverage

# --- Keep the example template ---
!.env.example
