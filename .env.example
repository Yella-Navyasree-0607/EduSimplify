# ─────────────────────────────────────────────────────────────────────────────
# EduSimplify – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The application reads these via python-dotenv OR you can set them directly
# in config.py (whichever you prefer).
#
# NEVER commit your real .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# IBM watsonx.ai credentials
# Get from: https://cloud.ibm.com/
#   API key    -> Manage -> Access (IAM) -> API keys -> Create
#   Project ID -> watsonx.ai project -> Manage -> General -> Project ID
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_REGION=us-south

# IBM Granite model (default: granite-13b-instruct-v2)
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Flask settings
FLASK_DEBUG=false
FLASK_PORT=5000
FLASK_SECRET_KEY=change-this-to-a-random-string
